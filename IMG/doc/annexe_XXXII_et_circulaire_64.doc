}}\paperw11900\paperh16820\margl1251\margr1303\margt1380\margb1227 \ftnbj\aenddoc\ftnrestart\hyphhotz425\noxlattoyen\expshrtn\noultrlspc\dntblnsbdb\nospaceforul\hyphcaps0\horzdoc\dgmargin\dghspace120\dgvspace120\dghorigin1251\dgvorigin1380\dghshow0\dgvshow3\jcompress\viewkind1\viewscale115\nolnhtadjtbl\rsidroot7734170 \fet0\sectd \linex0\colsx0\sectdefaultcl\sftnbj {\footer \pard\plain \ql \li0\ri0\widctlpar\faauto\rin0\lin0\itap0 \f5\lang1036\langfe1036\cgrid\langnp1036\langfenp1036 {\i\f4\insrsid7734170  page \chpgn  sur \chpgn }{\insrsid7734170 \par }}{\*\pnseclvl1\pnucrm\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl2\pnucltr\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl3\pndec\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl4\pnlcltr\pnstart1\pnindent720\pnhang{\pntxta )}}{\*\pnseclvl5\pndec\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl6\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl7\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl8\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl9\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}\pard\plain \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 \f5\lang1036\langfe1036\cgrid\langnp1036\langfenp1036 {\b\f157\fs48\ul\insrsid7734170 ANNEXE XXXII}{\f157\insrsid7734170 \par }\pard \qj \li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \li20\ri5060\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin5060\lin20\itap0 {\i\f157\insrsid7734170 (D\u233\'8ecret n\u176\'a1 56-284 du 9 mars 1956 (Annexe 32 ajout\u233\'8ee par d\u233\'8ecret n\u176\'a163-146 du 18 f\u233\'8evrier 1963.)\par }\pard \qj \li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\i\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Conditions techniques d'agr\u233\'8ement\par des centres M\u201\'83DICO-PSYCHO-P\u201\'83DAGOGIQUES de cure ambulatoire.\par }\pard \qc \li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article premier.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Les centres m\u233\'8edico-psycho-p\u233\'8edagogiques pratiquent le diagnostic et le traitement des enfants inadapt\u233\'8es mentaux dont l'inadaptation est li\u233\'8ee \u224\'88 des troubles neuro-psychiques ou \u224\'88 des troubles du comportement susceptibles d'une th\u233\'8erapeutique m\u233\'8edicale, d'une r\u233\'8e\u233\'8education m\u233\'8edico-psychologique ou d'une r\u233\'8e\u233\'8education psychoth\u233\'8erapique ou psychop\u233\'8edagogique sous autorit\u233\'8e m\u233\'8edicale.\par Le diagnostic et le traitement sont effectu\u233\'8es en consultations ambulatoires sans hospitalisation du malade.\par Ils sont toujours mis en \u339\'cfuvre par une \u233\'8equipe compos\u233\'8ee de m\u233\'8edecins, d'auxiliaires m\u233\'8edicaux, de psychologues  tics, d'assistantes sociales et, autant que de besoin, de p\u233\'8edagogues et de r\u233\'8e\u233\'8educateurs.\par Ils ont pour but de r\u233\'8eadapter l'enfant en le maintenant dans son milieu familial, scolaire ou professionnel et social.\par Le traitement comprend une action sur la famille qui peut recevoir au centre toutes les indications n\u233\'8ecessaires \u224\'88 la r\u233\'8eadaptation de l'enfant et \u233\'8eventuellement toutes les th\u233\'8erapeutiques lorsque, dans l'int\u233\'8er\u234\'90t de l'enfant, elles ne peuvent \u234\'90tre dispens\u233\'8ees ailleurs.  Les soins s'\u233\'8etendent \u224\'88 la postcure.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 2}{\f157\insrsid7734170 .\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 L'organisation g\u233\'8en\u233\'8erale, le personnel, l'\u233\'8equipement et les services d'un centre m\u233\'8edico-psycho-p\u233\'8edagogique de cure ambulatoire doivent \u234\'90tre fonction de sa capacit\u233\'8e r\u233\'8eelle d'utilisation, c'est-\u224\'88-dire du nombre maximum de consultants pouvant y \u234\'90tre normalement admis au cours d'une m\u234\'90me s\u233\'8eance.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 3.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Les sols des locaux doivent \u234\'90tre tenus en parfait \u233\'8etat de propret\u233\'8e\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Les murs et les cloisons doivent \u234\'90tre enduits d'une peinture lavable, claire de pr\u233\'8ef\u233\'8erence ; le papier est exclu, \u224\'88 moins qu'il ne soit aussi lavable que la peinture elle-m\u234\'90me.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 4.}{\f157\insrsid7734170 \par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 L'a\u233\'8eration doit \u234\'90tre permanente et con\u231\'8due de mani\u232\'8fre \u224\'88 fonctionner en toute saison, sans occasionner de g\u234\'90ne aux consultants.\par Le chauffage central ou tout syst\u232\'8fme offrant les m\u234\'90mes possibilit\u233\'8es et garanties est recommand\u233\'8e dans tout centre m\u233\'8edico-psycho-p\u233\'8edagogique. La temp\u233\'8erature des locaux ne doit jamais \u234\'90tre inf\u233\'8erieure \u224\'88 18\u176\'a1.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 L'\u233\'8eclairage \u233\'8electrique est obligatoire.\par \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 5.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Le centre doit disposer d'eau potable en quantit\u233\'8e suffisante. L'\u233\'8evacuation des eaux us\u233\'8ees doit \u234\'90tre assur\u233\'8ee conform\u233\'8ement aux r\u232\'8fgles d'hygi\u232\'8fne. Les lavabos et les W.-C. doivent \u234\'90tre en nombre suffisant. Les cabinets d'aisance doivent \u234\'90tre bien a\u233\'8er\u233\'8es, ventil\u233\'8es et \u233\'8eclair\u233\'8es, comporter une chasse d'eau, un siphon hydraulique et un poste d'eau.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 6.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Contre la risque d'incendie, le centre doit r\u233\'8epondre aux r\u232\'8fglements en vigueur et disposer notamment\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 a) De postes d'eau;\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 b) D'extincteurs \u224\'88 chaque \u233\'8etage;\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 c) D'un moyen d'appel rapide au poste des pompiers le plus proche.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 La construction et l'am\u233\'8enagement des locaux doivent permettre leur prompte \u233\'8evacuation en cas de sinistre.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 7.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Le centre doit poss\u233\'8eder le t\u233\'8el\u233\'8ephone avec la ville et avoir, en \u233\'8evidence et \u224\'88 proximit\u233\'8e de l'appareil, les adresses et les num\u233\'8eros de t\u233\'8el\u233\'8ephone dont on peut avoir besoin d'urgence. Il doit autant que possible disposer d'un r\u233\'8eseau t\u233\'8el\u233\'8ephonique int\u233\'8erieur.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 8.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Les locaux sont nettoy\u233\'8es et a\u233\'8er\u233\'8es chaque s\u233\'8eance de consultations.\par \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 9.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Le centre m\u233\'8edico-psycho-p\u233\'8edagogique doit poss\u233\'8eder au moins, compte tenu des pr\u233\'8ecisions de l'article 2:\par Une salle d'attente spacieuse et contenant un nombre de si\u232\'8fges, proportionn\u233\'8e au nombre de consultants et de personnes susceptibles de les accompagner. A cette salle est annex\u233\'8e un bureau pour la personne charg\u233\'8ee d'accueillir et de renseigner les enfants ou leurs parents\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Un secr\u233\'8etariat ;\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Un bureau m\u233\'8edical pourvu de tout l'outillage indispensable \u224\'88 l'examen correct des consultants ;\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Un box au moins r\u233\'8eserv\u233\'8e aux examens psychologiques ;\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Des boxes en nombre suffisant, insonoris\u233\'8es, pour les r\u233\'8e\u233\'8educations individuelles, l'orthophonie, les psychoth\u233\'8erapies, etc. ;\par Une salle pour le service social et, \u233\'8eventuellement, des boxes en nombre suffisant pour les diverses assistantes sociales,\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx1560\tx3260\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \u201\'83ventuellement, une salle destin\u233\'8ee \u224\'88 la psychoth\u233\'8erapie de groupe et une salle pour la r\u233\'8e\u233\'8education psychomotrice ou les r\u233\'8e\u233\'8educations collectives ;\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \u201\'83ventuellement les installations n\u233\'8ecessaires pour un service d'\u233\'8electro-enc\u233\'8ephalographie et un ou plusieurs bureaux destin\u233\'8es aux examens des sp\u233\'8ecialistes et am\u233\'8enag\u233\'8es selon les exigences de chaque sp\u233\'8ecialit\u233\'8e.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Une pi\u232\'8fce de dimensions suffisantes devra pouvoir \u234\'90tre utilis\u233\'8es comme salle de r\u233\'8eunions de synth\u232\'8fse et de travail.\par Une r\u233\'8eserve de pharmacie avec placard fermant \u224\'88 cl\u233\'8e pourra \u234\'90tre pr\u233\'8evue. Sinon, un}{\b\f157\insrsid7734170  }{\f157\insrsid7734170 placard fermant \u224\'88 cl\u233\'8e et contenant les substances v\u233\'8en\u233\'8eneuses sera am\u233\'8enag\u233\'8e dans le bureau m\u233\'8edical.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 10.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\b\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Les consultations de diagnostic et de traitement n'ont lieu que sur rendez-vous ; le nombre des pi\u232\'8fces et des boxes pr\u233\'8evus \u224\'88 l'article 9 doit permettre un fonctionnement r\u233\'8egulier du centre sans que les consultants aient \u224\'88 attendre avant une consultation ni entre les examens ou les r\u233\'8e\u233\'8educations susceptibles d'\u234\'90tre pratiqu\u233\'8ees au cours d'une m\u234\'90me s\u233\'8eance.\par Le centre doit s'attacher \u224\'88 r\u233\'8eduire les d\u233\'8eplacements des consultants en pratiquant au cours d'une m\u234\'90me s\u233\'8eance les examens et r\u233\'8e\u233\'8educations chaque fois que cela est compatible avec les exigences du diagnostic et du traitement.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 11.}{\f157\insrsid7734170 \par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Chaque consultant doit poss\u233\'8eder un dossier dans lequel figurent les renseignements d'ordre social, les \u233\'8el\u233\'8ements du diagnostic, le relev\u233\'8e des examens pratiqu\u233\'8es, des traitements et des techniques de r\u233\'8e\u233\'8education prescrits et des r\u233\'8esultats obtenus. Ce dossier, r\u233\'8eguli\u232\'8frement tenu \u224\'88 jour, est class\u233\'8e dans un meuble fermant \u224\'88 cl\u233\'8e, pour \u234\'90tre mis, sous la responsabilit\u233\'8e du m\u233\'8edecin directeur, \u224\'88 l'abri de toute indiscr\u233\'8etion.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 12.}{\f157\insrsid7734170 \par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Le m\u233\'8edecin directeur du centre m\u233\'8edico-psycho-p\u233\'8edagogique doit obligatoirement \u234\'90tre qualifi\u233\'8e en p\u233\'8ediatrie ou en neuro-psychiatrie et avoir des connaissances particuli\u232\'8fres respectivement en psychiatrie infantile ou en p\u233\'8ediatrie. \par Le m\u233\'8edecin directeur doit \u234\'90tre agr\u233\'8e\u233\'8e par le directeur d\u233\'8epartemental de la sant\u233\'8e.\par L'ensemble du personnel du centre composant l'\u233\'8equipe pr\u233\'8evue \u224\'88 l'article 1er est plac\u233\'8e, au point de vue technique, sous l'autorit\u233\'8e et la responsabilit\u233\'8e du m\u233\'8edecin directeur.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Le ou les m\u233\'8edecins attach\u233\'8es au centre m\u233\'8edico-psycho-p\u233\'8edagogique doivent \u234\'90tre agr\u233\'8e\u233\'8es par le directeur d\u233\'8epartemental de la sant\u233\'8e. Ils assurent en personne la consultation et, sauf le cas de cong\u233\'8e annuel ou de maladie, ils ne peuvent se faire remplacer qu'\u224\'88 titre exceptionnel ; leur remplacement ne peut \u234\'90tre assur\u233\'8e que par des docteurs en m\u233\'8edecine.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Ils pourront en cas de besoin recourir \u224\'88 l'avis d'un m\u233\'8edecin consultant.\par Aucun traitement ou r\u233\'8e\u233\'8education n'est entrepris s'il n'a \u233\'8et\u233\'8e prescrit par l'un des m\u233\'8edecins agr\u233\'8e\u233\'8es.\par Les m\u233\'8edecins doivent avoir, dans la pratique des soins collectifs le m\u234\'90me respect de la personne humaine que dans l'exercice de la client\u232\'8fle priv\u233\'8ee. Ils doivent, en cons\u233\'8equence, proc\u233\'8eder toujours \u224\'88 l'examen individuel des consultants et consacrer un temps suffisant \u224\'88\tab chacun d'eux.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\tx4400\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Ils signent eux-m\u234\'90mes les certificats, les feuilles de maladie ainsi que les      ordonnances ; en aucun cas ils ne peuvent d\u233\'8el\u233\'8eguer leur signature.  Ils                                                 doivent, le cas \u233\'8ech\u233\'8eant, adresser aux organismes responsables les pr\u233\'8eavis                                                 de traitement.\par S'ils remettent une ordonnance, celle-ci doit comporter l'adresse du centre, leur nom, leurs fonctions au centre et leur signature. En aucun cas ne doit \u234\'90tre mentionn\u233\'8ee l'adresse de leur cabinet personnel de consultation.\par Il est interdit aux m\u233\'8edecins d'user de leur activit\u233\'8e au centre pour augmenter leur client\u232\'8fle particuli\u232\'8fre.\par \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 13. \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\tx4400\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \par Le centre doit s'assurer la collaboration d'un psychologue au moins, celui-ci doit remplir les conditions pr\u233\'8evues pour les psychologues attach\u233\'8es aux services publics.\par Les investigations psychologiques sont \u233\'8etablies \u224\'88 la demande du m\u233\'8edecin agr\u233\'8e\u233\'8e et sous sa responsabilit\u233\'8e.\par \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 14.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\tx4400\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170  }{\f157\insrsid7734170 \par  Lorsque le centre dispense une r\u233\'8e\u233\'8education p\u233\'8edagogique sp\u233\'8ecialis\u233\'8ee, individuelle ou collective, il doit s'assurer le concours de p\u233\'8edagogues ou d'\u233\'8educateurs poss\u233\'8edant la qualification requise et justifiant d'une connaissance particuli\u232\'8fre des d\u233\'8eficiences dont les enfants re\u231\'8dus au centre sont atteints.\par \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 15.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\tx4400\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \par La coordination des activit\u233\'8es psychologiques et p\u233\'8edagogiques peut \u234\'90tre confi\u233\'8ee \u224\'88 un des membres de l'\u233\'8equipe qui devra justifier d'une formation appropri\u233\'8ee en psychologie et en p\u233\'8edagogie.\par \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 16.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\tx4400\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \par Lorsque le centre dispense, sous l'autorit\u233\'8e et la responsabilit\u233\'8e des m\u233\'8edecins agr\u233\'8e\u233\'8es, aux enfants dont l'\u233\'8etat le requiert une psychanalyse, une r\u233\'8e\u233\'8education psychoth\u233\'8erapique, une r\u233\'8e\u233\'8education de la parole, une r\u233\'8e\u233\'8education de la psychomotricit\u233\'8e, il doit s'assurer le concours d'un personnel comp\u233\'8etent.\par }{\b\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170  Article 17. }{\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\tx4400\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \par Le centre doit comporter un service social.\par Le ou les assistants ou assistantes sociaux doivent notamment assurer une liaison avec le ou les services sociaux qui auraient pris ant\u233\'8erieurement en charge les enfants ou leurs familles et avec celui ou ceux qui veilleront \u224\'88 l'adaptation de l'enfant \u224\'88 son cadre familial, scolaire ou professionnel et social.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Ils doivent \u233\'8egalement aider le sujet en fin de traitement et maintenir le contact avec lui pendant une dur\u233\'8ee minimum de trois ans, de mani\u232\'8fre \u224\'88 pouvoir \u233\'8eventuellement provoquer un nouvel examen ou rechercher s'il y a lieu, les causes d'une mauvaise adaptation.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\tx4400\tqr\tx9080\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 18.}{\f4\fs18\insrsid7734170 \par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\f4\fs18\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Le m\u233\'8edecin directeur organise r\u233\'8eguli\u232\'8frement et pr\u233\'8eside des r\u233\'8eunions de synth\u232\'8fse qui assurent la coordination du travail des membres de J'\u233\'8equipe pr\u233\'8evue \u224\'88 l'article le, et auxquelles participent les divers techniciens du centre qui ont assur\u233\'8e les examens et les soins \u224\'88 l'enfant dont le cas est \u233\'8etudi\u233\'8e lors de la r\u233\'8eunion.\par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Le m\u233\'8edecin directeur informe apr\u232\'8fs chaque r\u233\'8eunion de synth\u232\'8fse, les parents et, \u233\'8eventuellement, le m\u233\'8edecin traitant de l'\u233\'8evolution l'\u233\'8etat de l'enfant. Il charge le p\u233\'8edagogue du centre de tenir les ma\u238\'94tres de l'enfant inform\u233\'8es, sous r\u233\'8eserve du secret m\u233\'8edical, des renseignements psychologiques et m\u233\'8edicaux qui peuvent les int\u233\'8eresser et des r\u233\'8e\u233\'8educations envisag\u233\'8ees.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 19.}{\f157\insrsid7734170 \par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Tout le personnel du centre est tenu d'observer les r\u232\'8fgles du secret m\u233\'8edical.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 20.}{\f157\insrsid7734170 \par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 Avant son entr\u233\'8ee en fonctions, tout membre du personnel doit \u234\'90tre soumis \u224\'88 un examen m\u233\'8edical, comportant notamment un examen radiologique des poumons.\par Ce personnel doit \u234\'90tre indemne de toute affection tuberculeuse, \u224\'88 l'exception de s\u233\'8equelles anciennes ou cicatricielles.\par L'examen m\u233\'8edical et l'examen radiologique doivent \u234\'90tre renouvel\u233\'8es au moins une fois par an, pour v\u233\'8erifier le bon \u233\'8etat de sant\u233\'8e du personnel.\par Apr\u232\'8fs une maladie contagieuse, aucun agent n'est autoris\u233\'8e \u224\'88 reprendre son service avant d'avoir \u233\'8et\u233\'8e reconnu inapte \u224\'88 transmettre cette maladie, notamment par la recherche des germes pathog\u232\'8fnes dans les exsudats ou \u233\'8emonctoires deux fois \u224\'88 huit jours d'intervalle.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 21.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0 {\f157\insrsid7734170 La distribution d'\u233\'8echantillons pharmaceutiques ou la vente de m\u233\'8edicaments est interdite.\par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qc \li20\ri0\widctlpar\tqc\tx140\tqr\tx9080\faauto\rin0\lin20\itap0 {\b\f157\insrsid7734170 Article 22.}{\f157\insrsid7734170 \par }\pard \qj \fi840\li0\ri0\widctlpar\tqc\tx140\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0\pararsid7734170 {\f157\insrsid7734170 Le centre doit poss\u233\'8eder un r\u232\'8fglement int\u233\'8erieur pr\u233\'8ecisant les conditions particuli\u232\'8fres de son organisation et de son fonctionnement technique ; seront mentionn\u233\'8es en particulier le nombre maximal des consultations, la nature des traitements et r\u233\'8e\u233\'8educations pratiqu\u233\'8es et le nombre et la qualification du personnel n\u233\'8ecessaire correspondant.}{\f157\insrsid7734170 \par }\pard \ql \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0 {\f157\insrsid7734170 \page }{\b\f0\fs22\ul\cf1\insrsid7734170\charrsid7734170 Circulaire du 16 avril 1964 \par }\pard \ql \li0\ri0\widctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid7734170 {\f0\fs22\cf1\insrsid7734170\charrsid7734170 \par \par Le souci de la sant\u233\'8e mentale de la population exige la mise en place de dispositifs propres \u224\'88 assurer la prophylaxie, le d\u233\'8epistage, le diagnostic et le traitement de certains troubles neuro-psychiques et troubles du comportement qui compromettent franchement l'adaptation de l'individu au milieu qui l'environne, ou, s'il s'agit d'un enfant, ses chances de bonne insertion dans l'entourage familial, professionnel et social. \par Le cas des enfants est, en effet, particulier car les difficult\u233\'8es, m\u234\'90me b\u233\'8enignes, qu'ils rencontrent sont susceptibles en s'aggravant de provoquer \u224\'88 l'\u194\'e5ge adulte des comportements v\u233\'8eritablement d\u233\'8elictuels ou pathologiques. \par En outre, l'efficacit\u233\'8e du d\u233\'8epistage et du traitement d\u233\'8epend de sa pr\u233\'8ecocit\u233\'8e, par cons\u233\'8equent, de la mise \u224\'88 la disposition des jeunes et de leurs parents d'organismes sp\u233\'8ecialis\u233\'8es anim\u233\'8es par un personnel particuli\u232\'8frement inform\u233\'8e des troubles de l'enfance et de l'adolescence. \par Tel est l'objet des centres m\u233\'8edico-psycho-p\u233\'8edagogiques dont l'activit\u233\'8e est double : au d\u233\'8epistage des troubles assur\u233\'8es par les centres, comme par les dispensaires d'hygi\u232\'8fne -mentale, s'ajoute la mise en \u339\'cfuvre de soins et de traitements appropri\u233\'8es. \par Des centres de cette nature fonctionnent depuis plusieurs ann\u233\'8ees dans maintes r\u233\'8egions de la France et leur utilit\u233\'8e ainsi que la sp\u233\'8ecificit\u233\'8e de leur vocation s'affirment toujours davantage. \par Leur r\u233\'8egime financier n'est cependant pas uniform\u233\'8ement fix\u233\'8e et offre des difficult\u233\'8es qui g\u234\'90nent leur d\u233\'8eveloppement et la cr\u233\'8eation de nouveaux centres. \par Il importait, pour rem\u233\'8edier \u224\'88 cette situation, de pr\u233\'8evoir un r\u233\'8egime financier plus rationnel et de d\u233\'8efinir, d'une fa\u231\'8don pr\u233\'8ecise les organismes qui pourraient en b\u233\'8en\u233\'8eficier. C'est l'objet du d\u233\'8ecret du 18 f\u233\'8evrier 1963 et des pr\u233\'8esentes instructions. \tab \par La double activit\u233\'8e, des centres, entra\u238\'94ne en effet deux modes de financement distincts, sans pr\u233\'8ejudice bien entendu des apports d'une autre origine, sous forme par exemple de personnels, mis \u224\'88 la disposition des centres par le minist\u232\'8fre de l'\u201\'83ducation nationale. Le double financement s'explique ainsi :\par Les t\u226\'89ches de d\u233\'8epistage impliquent l'int\u233\'8egration des centres dans le service d\u233\'8epartemental d'hygi\u232\'8fne mentale, dont la vocation est plus g\u233\'8en\u233\'8erale ; l'activit\u233\'8e th\u233\'8erapeutique des centres est de nature \u224\'88 permettre le jeu des prises en charge financi\u232\'8fres dans les conditions du droit commun. \par Seuls, les centres li\u233\'8es par convention avec le service d\u233\'8epartemental d'hygi\u232\'8fne mentale pourront b\u233\'8en\u233\'8eficier d\rquote une prise en charge de leur activit\u233\'8e de \u171\'c7 consultations \u187\'c8 par le d\u233\'8epartement. Et seuls, les centres agr\u233\'8e\u233\'8es par les commissions r\u233\'8egionales d'agr\u233\'8ement des \u233\'8etablissements priv\u233\'8es de cure et de pr\u233\'8evention d'une part, et conventionn\u233\'8es au titre de l'aide m\u233\'8edicale d'autre part, b\u233\'8en\u233\'8eficieront de remboursements au titre de l'assurance maladie ou de l'aide m\u233\'8edicale.\par Le fonctionnement et le financement des centres seront successivement \u233\'8etudi\u233\'8es. \par \par 1. FONCTIONNEMENT G\u201\'83N\u201\'83RAL \par DES CENTRES M\u201\'83DICO-PSYCHO-P\u201\'83DAGOGIQUES\par \par Les centres assurent le d\u233\'8epistage des enfants et des adolescents dont l'inadaptation est li\u233\'8ee \u224\'88 des troubles neuro-psychiques, ou \u224\'88 des troubles du comportement. \par Sit\u244\'99t le diagnostic pos\u233\'8e, les centres permettent la mise en oeuvre sur ces enfants, inadapt\u233\'8es ou en voie d'inadaptation seulement, de th\u233\'8erapeutiques m\u233\'8edicales, et de r\u233\'8e\u233\'8educations\tab m\u233\'8edico-psychologique, psycho-th\u233\'8erapeutique, ou psycho-p\u233\'8edagogique sous autorit\u233\'8e m\u233\'8edicale.\par Les probl\u232\'8fmes de l\rquote admission des enfants et des normes d'organisation doivent \u234\'90tre examin\u233\'8es successivement.\par \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 \par A) Admission des enfants\par }{\f0\fs22\cf1\insrsid7734170\charrsid7734170 \par L'activit\u233\'8e de d\u233\'8epistage des centres est coordonn\u233\'8ee avec celle des dispensaires d'hygi\u232\'8fne mentale proprement dits, d'une part pour \u233\'8eviter tout double emploi, d'autre part pour assurer une meilleure efficacit\u233\'8e du dispositif mis en place. \par Les centres m\u233\'8edico-psycho-p\u233\'8edagogiques jouent en principe le r\u244\'99le de dispensaires \u171\'c7 secondaires \u187\'c8, par opposition aux dispensaires d'hygi\u232\'8fne mentale, qui servent de consultations \u171\'c7 primaires \u187\'c8 , et re\u231\'8doivent, sans tri pr\u233\'8ealable, n'importe quel enfant inadapt\u233\'8e de leur secteur. Le renvoi du cas, du dispensaire au centre, s\rquote effectue chaque fois que le dispensaire ordinaire souhaite pour un mineur des investigations, soit compl\u233\'8ementaires, soit d'un type particulier, qui sont autant de pr\u233\'8ealables \u224\'88 la mise en \u339\'cfuvre d'un traitement appropri\u233\'8e,\par Toutefois, l'absence de dispensaire d'hygi\u232\'8fne mentale dans une circonscription d\u233\'8etermin\u233\'8ee, peut amener un centre \u224\'88 \u234\'90tre saisi le premier du cas d'enfants manifestant un trouble de l'adaptation familiale ou scolaire. Le centre joue alors, le r\u244\'99le de dispensaire primaire : Il est agr\u233\'8e\u233\'8e comme tel, il doit \u234\'90tre conventionn\u233\'8e \u224\'88 cet effet (cf. le 2 \u232\'8fme alin\u233\'8ea de l'article I du projet de contrat). \par Il peut arriver \u233\'8egalement qu'un enfant soit adress\u233\'8e directement au centre par l'interm\u233\'8ediaire du m\u233\'8edecin scolaire, ou de la commission m\u233\'8edico-p\u233\'8edagogique cr\u233\'8e\u233\'8ee dans le cadre de l'enseignement primaire, ou du psychologue scolaire attach\u233\'8e \u224\'88 un' \u233\'8etablissement. \par En dehors de ce cas, il peut arriver qu'un juge des enfants adresse directement un enfant au centre ; il conviendra alors de rechercher si le sujet a d\u233\'8ej\u224\'88 \u233\'8et\u233\'8e examin\u233\'8e par une consultation d'hygi\u232\'8fne mentale, et d'\u233\'8etablir, le cas \u233\'8ech\u233\'8eant, une liaison avec cet organisme.\par Que l'intervention du centre se fasse au premier ou au second degr\u233\'8e, il faut que dans tous les cas, le centre soit habilit\u233\'8e \u224\'88 traiter l'enfant de son milieu familial et scolaire. Si un entretien est n\u233\'8ecessaire avec une nu plusieurs personnes de l'entourage de l'enfant, cet entretien fait partie des soins donn\u233\'8es \u224\'88 l'enfant, sans qu'il soit n\u233\'8ecessaire de pr\u233\'8evoir une r\u233\'8emun\u233\'8eration sp\u233\'8eciale du membre de l'\u233\'8equipe du centre qui s'en charge. \par \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 B) Normes d'organisation et de fonctionnement}{\f0\fs22\cf1\insrsid7734170\charrsid7734170 \par \par Les conditions techniques d\rquote agr\u233\'8ement des centres m\u233\'8edico-psycho-p\u233\'8edagogiques de cure ambulatoire ont \u233\'8et\u233\'8e d\u233\'8efinies par le d\u233\'8ecret no 63-146 du 18 f\u233\'8evrier 1963, (annexe XXXII du d\u233\'8ecret du 9 avril 1956). Les m\u234\'90mes normes de locaux, de mat\u233\'8eriel et de personnel seront exigibles pour que le centre puisse passer convention avec le service d\u233\'8epartemental d'hygi\u232\'8fne mentale, et le service d'aide m\u233\'8edicale, dont les prises en charge seront explicit\u233\'8ees ci-dessous.\par L'annexe XXXII appelle sur certains points les pr\u233\'8ecisions suivantes :\par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 Art. 12.}{\f0\fs22\cf1\insrsid7734170\charrsid7734170  -Le terme d m\u233\'8edecin-directeur s'entend du m\u233\'8edecin-chef qui participe effectivement \u224\'88 toute l'activit\u233\'8e et \u224\'88 toutes les responsabilit\u233\'8es techniques, et qui notamment dirige l\rquote ensemble du personnel.\par Lorsqu'il existe dans un centre une double direction,\tab l\rquote une \u224\'88 caract\u232\'8fre m\u233\'8edical l'autre \u224\'88 caract\u232\'8fre p\u233\'8edagogique, cette derni\u232\'8fre assurant \u233\'8egale des t\u226\'89ches administratives, les organismes de prise en charge peuvent tenir compte du traitement des deux directeurs, si l'opportunit\u233\'8e de cette mesure n'est pas douteuse. \par Quoi qu'il en soit sur ce point, le m\u233\'8edecin-directeur participe effectivement \u224\'88 toute l'autorit\u233\'8e, et \u224\'88 toutes les responsabilit\u233\'8es techniques. Il exerce vis \u224\'88 vis des interlocuteurs du centre la pl\u233\'8enitude des fonctions de direction.\par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 Art. 12 (dernier alin\u233\'8ea)}{\f0\fs22\cf1\insrsid7734170\charrsid7734170 . - Il est interdit aux m\u233\'8edecins d'user de leur activit\u233\'8e au centre pour augmenter leur client\u232\'8fle particuli\u232\'8fre. Il va de soi que cette d\u233\'8efense doit \u234\'90tre \u233\'8egalement faite aux autres sp\u233\'8ecialistes du centre. \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 Art. 14 et 16.}{\f0\fs22\cf1\insrsid7734170\charrsid7734170  - Le centre qui dispense une psychanalyse ou certaines r\u233\'8e\u233\'8educations sp\u233\'8eciales, doit s'assurer du concours d'un personnel comp\u233\'8etent. \par Ce personnel peut \u234\'90tre, soit attach\u233\'8e au centre \u224\'88 temps plein ou partiel, soit requis par lui en temps opportun pour le traitement de cas isol\u233\'8es. \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 Art. 22.}{\f0\fs22\cf1\insrsid7734170\charrsid7734170  - Le r\u232\'8fglement int\u233\'8erieur pr\u233\'8ecise notamment le nombre et la qualification du personnel n\u233\'8ecessaire, attach\u233\'8e au centre. \par Ce personnel ne comprend que les membres de l'\u233\'8equipe, sp\u233\'8ecialistes et agents divers, attach\u233\'8es au centre de fa\u231\'8don r\u233\'8eguli\u232\'8fre. Il n'est pas n\u233\'8ecessaire que le r\u232\'8fglement int\u233\'8erieur mentionne les personnes appel\u233\'8ees de l'ext\u233\'8erieur \u224\'88 titre occasionnel ; il suffit que le repr\u233\'8esentant du ministre de la Sant\u233\'8e publique et de la Population et la caisse r\u233\'8egionale de S\u233\'8ecurit\u233\'8e sociale avec laquelle le centre a pass\u233\'8e convention soient tenus au courant de leurs activit\u233\'8es et du montant des vacations qui leur sont allou\u233\'8ees. \par \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 II. FINANCEMENT DES CENTRES M\u201\'83DICO-PSYCHO-P\u201\'83DAGOGIQUES\par \par A) Principes\par }{\f0\fs22\cf1\insrsid7734170\charrsid7734170 \par La double qualit\u233\'8e reconnue aux centres m\u233\'8edico-psycho-p\u233\'8edagogiques permet de pr\u233\'8evoir deux modes, conjoints de financement, selon que les s\u233\'8eances pour chaque mineur sont r\u233\'8eput\u233\'8ees de d\u233\'8epistage ou de traitement. \par Je ne puis donc que vous recommander tr\u232\'8fs vivement \par - L'int\u233\'8egration dans, le, service d\u233\'8epartemental d'hygi\u232\'8fne mentale, des centres qui remplissent les conditions, pr\u233\'8evues \u224\'88 l'annexe XXXII, en tant qu'ils exercent une activit\u233\'8e de d\u233\'8epistage ; \par - La passation d'une convention avec ces centres, pour les activit\u233\'8es de soins, au titre de l'aide m\u233\'8edicale. \par En ce qui concerne le remboursement des caisses de S\u233\'8ecurit\u233\'8e sociale au titre de l'assurance-maladie, les conventions entre elles et les centres pr\u233\'8eciseront que le tarif de remboursement des forfaits de s\u233\'8eances de traitement est calcul\u233\'8e comme il est pr\u233\'8evu ci - apr\u232\'8fs.\par Lorsque la r\u233\'8epartition des d\u233\'8epenses entre ces diverses collectivit\u233\'8es a \u233\'8et\u233\'8e \u233\'8etudi\u233\'8ee, et pour \u233\'8eviter les contestations, il importait de d\u233\'8eterminer \u224\'88 partir de quel moment l'information m\u233\'8edicale pourrait \u234\'90tre consid\u233\'8er\u233\'8ee comme suffisante pour permettre la mise en \u339\'cfuvrc d'un traitement. En. d'autres termes, il fallait fixer le stade \u224\'88 partir duquel les organismes de prise en charge se substituent au service d\u233\'8epartemental d'hygi\u232\'8fne mentale pour financer les services rendus par les centres. Ce stade est naturellement variable avec chaque personne examin\u233\'8ee, selon que l'ensemble des investigations pr\u233\'8ealables \u224\'88 la mise en \u339\'cfuvre d\rquote un traitement requiert peu ou beaucoup de temps, suppose l'intervention d'un on deux sp\u233\'8ecialistes, ou au contraire le concours de l\rquote \u233\'8equipe enti\u232\'8fre du centre. Comme il ne pouvait \u234\'90tre question d'appr\u233\'8ecier s\u233\'8epar\u233\'8ement chaque cas, il a \u233\'8et\u233\'8e d\u233\'8ecid\u233\'8e d'\u233\'8etablir un forfait de six s\u233\'8eances par personne examin\u233\'8ee, ce qui signifie que les six premi\u232\'8fres s\u233\'8eances sont prises en charge par le service d\u233\'8epartemental d\rquote hygi\u232\'8fne mentale relay\u233\'8e par d'autres organismes \u224\'88 partir de la septi\u232\'8fme. \par Le terme de \u171\'c7 s\u233\'8eance\rdblquote  s\rquote entend ici du d\u233\'8eplacement que le mineur, convoqu\u233\'8e \u224\'88 cet effet, fait au centre. Au cours d'une seule \u171\'c7 s\u233\'8eance\rdblquote  le mineur peut \u234\'90tre examin\u233\'8e par un ou plusieurs membres de l'\u233\'8equipe ; la dur\u233\'8ee de ces examens peut \u234\'90tre de dur\u233\'8ee variable ; une \u171\'c7 s\u233\'8eance \u187\'c8 au sens des pr\u233\'8esentes instructions, peut donc durer une fraction d\rquote heure ou une journ\u233\'8ee enti\u232\'8fre. Le mineur examin\u233\'8e au cours de la \u171\'c7 s\u233\'8eance \u187\'c8 peut \u234\'90tre accompagn\u233\'8e ou non par une personne de son entourage familial ou scolaire, convoqu\u233\'8e par un membre de l'\u233\'8equipe du centre. \par Le forfait de six s\u233\'8eances r\u233\'8eput\u233\'8e \u234\'90tre \u171\'c7 de diagnostic \u187\'c8 peut donc couvrir des actes tr\u232\'8fs variables, d'un cas \u224\'88 l'autre, par leur nombre et par leur nature. Il ne peut y avoir qu'une seule r\u233\'8emun\u233\'8eration par jour. \par Le co\u251\'9et de la s\u233\'8eance pour chaque centre est obtenu de la fa\u231\'8don suivante les d\u233\'8epenses autoris\u233\'8ees (To. D\u233\'8ep.) sont fix\u233\'8ees par le pr\u233\'8efet, statuant sur avis conforme d'une commission compos\u233\'8ee des directeurs d\u233\'8epartementaux de la sant\u233\'8e et de la population, d'un repr\u233\'8esentant du directeur r\u233\'8egional de la S\u233\'8ecurit\u233\'8e sociale, et d'un repr\u233\'8esentant propos\u233\'8e par les caisses de S\u233\'8ecurit\u233\'8e, sociale int\u233\'8eress\u233\'8ees, et d\u233\'8esign\u233\'8e par le pr\u233\'8efet. En sont d\u233\'8eduites, les recettes (Rec) qui ne proviennent, ni du service d'hygi\u232\'8fne, ni des personnes, physiques ou morales, vis\u233\'8ees ci-dessous, qui prennent en charge les frais de traitement. Le montant des d\u233\'8epenses, ainsi obtenu (D\u233\'8ep.) est divis\u233\'8e par le nombre de \u171\'c7 s\u233\'8eantes \u187\'c8 (NS). Le quotient donne le co\u251\'9et moyen de la s\u233\'8eance (C) pour chaque centre, tel qu'il est retenu par les payeurs au titre du d\u233\'8epistage et du traitement, soit : \par \par Total des d\u233\'8epenses - Recettes = D\u233\'8epenses\par \par }{\f0\fs22\ul\cf1\insrsid7734170\charrsid7734170 D\u233\'8ep.\par }{\f0\fs22\cf1\insrsid7734170\charrsid7734170 NS\par \par Les reports d'exercice s'effectueront tous les deux ans. \par \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 Remarqu}{\f0\fs22\cf1\insrsid7734170\charrsid7734170 e : Il arrive que la client\u232\'8fle d'un centre soit domicili\u233\'8ee dans un ou plusieurs d\u233\'8epartements contigus de celui du si\u232\'8fge du centre. \par Une fraction des assur\u233\'8es et des assist\u233\'8es, souvent marginale, rel\u232\'8fve alors de services d\u233\'8epartementaux d'hygi\u232\'8fne mentale et de caisses de S\u233\'8ecurit\u233\'8e sociale qui n'ont pas conclu de convention avec le centre, contrairement \u224\'88 ce qui s'est pass\u233\'8e dans le d\u233\'8epartement du si\u232\'8fge. \par Dans ce cas les conventions pass\u233\'8ees, \u224\'88 titre principal dans le d\u233\'8epartement du lieu du si\u232\'8fge, seront reprises imm\u233\'8ediatement par les services et caisses des d\u233\'8epartements limitrophes. La client\u232\'8fle en provenance de ces derniers, et re\u231\'8due \u224\'88 titre accessoire, sera donc prise en charge dans les m\u234\'90mes conditions que la client\u232\'8fle re\u231\'8due \u224\'88 titre principal. \par S'il apparaissait toutefois que le rayonnement d\rquote un centre soit v\u233\'8eritablement interd\u233\'8epartemental, des modalit\u233\'8es de remboursement un peu diff\u233\'8erentes pourraient \u234\'90tre pr\u233\'8ecis\u233\'8ees dans les conventions. \par Je vous demande n\u233\'8eanmoins, de rechercher la plus grande simplicit\u233\'8e possible en cette, mati\u232\'8fre, puisque la commission qui statue, en mati\u232\'8fre budg\u233\'8etaire donne les garanties n\u233\'8ecessaires. \par \par \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 B) Frais de d\u233\'8epistage\par }{\f0\fs22\cf1\insrsid7734170\charrsid7734170 \par Chaque centre est, donc rembours\u233\'8e, dans les conditions pr\u233\'8evues par la convention pass\u233\'8ee suivant le mod\u232\'8fle-type ci-joint par le service d\u233\'8epartemental d\rquote hygi\u232\'8fne mentale, des d\u233\'8epenses engag\u233\'8ees au titre de son activit\u233\'8e de d\u233\'8epistage, soit une somme \u233\'8equivalente au produit de six \u171\'c7 s\u233\'8eances \u187\'c8 par le nombre de mineurs examin\u233\'8es. \par \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 N.B.-}{\f0\fs22\cf1\insrsid7734170\charrsid7734170  Il arrive qu'une appr\u233\'8eciable fraction de le client\u232\'8fle d'un centre provienne d'un dispensaire d'hygi\u232\'8fne mentale, qui, ayant d\u233\'8ej\u224\'88 effectu\u233\'8e une partie du travail de d\u233\'8epistage et de diagnostic, ne requiert du.centre qu'un compl\u233\'8ement d'investigation, ou la mise en \u339\'cfuvre d'un traitement particulier. Dans cette hypoth\u232\'8fse, le nombre de s\u233\'8eances du centre que le d\u233\'8epartement prend en charge au titre de l'hygi\u232\'8fne mentale peut \u234\'90tre r\u233\'8eduit par d\u233\'8ecision conjointe des directeurs d\u233\'8epartementaux de la sant\u233\'8e et de la population. Une telle r\u233\'8eduction du forfait de diagnostic n'est pas fix\u233\'8ee enfant par enfant. C'est l'activit\u233\'8e habituelle du centre qui peut donner lieu, pour tous les mineurs qui le fr\u233\'8equentent \u224\'88 r\u233\'8eduction de forfait. \par \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 C) Frais de traitement}{\f0\fs22\cf1\insrsid7734170\charrsid7734170 \par \par A ces remboursements, s'ajoutent, ceux que: les centres per\u231\'8doivent du fait de leur activit\u233\'8e th\u233\'8erapeutique. Les versements proviennent des caisses d'affiliation des assur\u233\'8es sociaux, des familles et de l'aide m\u233\'8edicale. \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 a}{\f0\fs22\cf1\insrsid7734170\charrsid7734170 ) En ce qui, concerne tout assur\u233\'8e social, la prise en charge au titre de l\rquote assurance-maladie ne s'op\u232\'8fre qu\rquote \u224\'88 partir de la premi\u232\'8fre s\u233\'8eance r\u233\'8eput\u233\'8ee \u234\'90tre consacr\u233\'8ee au traitement - Il s'agit, en r\u232\'8fgle g\u233\'8en\u233\'8erale, de la septi\u232\'8fme \u171\'c7 s\u233\'8eance \u187\'c8 (au. sens des pr\u233\'8esent\u233\'8es instructions) et des suivantes, \u224\'88 moins qu'il n'en soit stipul\u233\'8e autrement par l'accord conjoint vis\u233\'8e ci-dessus (\u167\'a4 B - Nota bene). \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 b}{\f0\fs22\cf1\insrsid7734170\charrsid7734170 ) Il est loisible aux familles de d\u233\'8eposer une demande d'aide m\u233\'8edicale pour obtenir la prise en charge des s\u233\'8eances r\u233\'8eput\u233\'8ees \ldblquote  de traitement \u187\'c8. Leurs dossiers seront instruits dans les conditions de droit commun, et les centres seront cr\u233\'8edit\u233\'8es par le tiers-payant. \par }{\i\f0\fs22\cf1\insrsid7734170\charrsid7734170 c}{\f0\fs22\cf1\insrsid7734170\charrsid7734170 ) Les familles d'enfants non pris en charge par l'assurance-maladie ou par l'aide m\u233\'8edicale paient le centre pour chaque \u171\'c7 s\u233\'8eance \u187\'c8 au-del\u224\'88 de la sixi\u232\'8fme. \par Dans son budget, chaque centre inscrit donc en recettes les sommes pr\u233\'8evues aux paragraphes a, b, c, dont le total est par d\u233\'8efinition \u233\'8egal au total des d\u233\'8epenses autoris\u233\'8ees - (postes budg\u233\'8etaires pr\u233\'8evue par le contrat-type : personnel, frais g\u233\'8en\u233\'8eraux, mat\u233\'8eriel technique et pharmacie, d\u233\'8epenses dues \u224\'88 des examens paracliniques) puisque le co\u251\'9et moyen de la s\u233\'8eance journali\u232\'8fre a \u233\'8et\u233\'8e calcul\u233\'8e \u224\'88 cet effet. \par Tel est le nouveau mode de financement dont l'application est propos\u233\'8ee aux centres m\u233\'8edico-psycho-p\u233\'8edagogiques. Ce financement con\u231\'8du pour faciliter le fonctionnement g\u233\'8en\u233\'8eral des centres, est double, en raison m\u234\'90me de leur double caract\u232\'8fre. \par Il est accessible \u224\'88 tout centre justifiant du respect des normes d\u233\'8efinies \u224\'88 l'annexe XXXII du d\u233\'8ecret du 9 mars 1956 modifi\u233\'8e et signataire d'une convention avec le d\u233\'8epartement, inspir\u233\'8ee du contrat type joint \u224\'88 cette circulaire. \par \par \par \par \par \par }\pard \qj \fi820\li20\ri0\widctlpar\tqc\tx140\tx280\faauto\rin0\lin20\itap0\pararsid7734170 {\insrsid7734170 \par }}